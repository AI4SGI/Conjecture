{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jacobian-frontier",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMUNITY",
        "class_name": "CommunityStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CommunityStore"]
    }
  ],
  "secrets": {
    "required": [
      "COMMUNITY_ADMIN_KEY",
      "COMMUNITY_AI_BASE_URL",
      "COMMUNITY_AI_MODEL_NAME",
      "COMMUNITY_AI_API_KEY",
      "COMMUNITY_FINGERPRINT_SALT"
    ]
  },
  "vars": {
    "COMMUNITY_AI_HOST_OVERRIDES": "{\"35.220.164.252\":\"252.164.220.35.bc.googleusercontent.com\"}",
    "COMMUNITY_ALLOWED_TARGETS": "{\"new\":[\"general\"],\"jacobian_conjecture\":[\"general\",\"P1\",\"P2\",\"P3\",\"P4\",\"P5\"],\"number_theory_001_beal_conjecture\":[\"general\",\"P1\"],\"number_theory_002_odd_perfect_number\":[\"general\",\"P1\"]}"
  }
}
