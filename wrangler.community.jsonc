{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jacobian-community-api",
  "main": "community-worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMUNITY",
        "class_name": "CommunityStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CommunityStore"]
    }
  ],
  "secrets": {
    "required": [
      "COMMUNITY_ADMIN_KEY",
      "COMMUNITY_AI_BASE_URL",
      "COMMUNITY_AI_MODEL_NAME",
      "COMMUNITY_AI_API_KEY",
      "COMMUNITY_FINGERPRINT_SALT"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://ai4sgi.github.io,http://localhost:3000,http://127.0.0.1:4173",
    "COMMUNITY_ALLOWED_TARGETS": "{\"jacobian_conjecture\":[\"general\",\"P1\",\"P2\",\"P3\",\"P4\",\"P5\"],\"number_theory_001_beal_conjecture\":[\"general\",\"P1\"],\"number_theory_002_odd_perfect_number\":[\"general\",\"P1\"]}"
  }
}
